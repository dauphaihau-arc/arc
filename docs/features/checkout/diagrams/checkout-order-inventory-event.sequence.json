{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Order and Inventory Event Flow",
    "locale": "en",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [1680, 600],
    "views": [
      { "id": "reserve-and-persist", "label": "Reserve then persist", "focus": ["web", "order", "quote", "inventory"], "note": "Order creation creates the hold inside the same transaction that writes order.created." },
      { "id": "order-created-event", "label": "order.created to SOLD", "focus": ["order", "invoutbox", "rabbit", "inventory"], "note": "Each order.created carries that Order's reservationId; the consumer moves it to SOLD." },
      { "id": "invalid-reservation", "label": "Reservation failed", "focus": ["inventory", "order", "web"], "note": "An out-of-stock or failed hold ends order creation with RESERVATION_FAILED." }
    ]
  },
  "participants": [
    { "id": "web", "type": "frontend", "label": "Storefront Web" },
    { "id": "order", "type": "backend", "label": "Order Creation API" },
    { "id": "quote", "type": "backend", "label": "Checkout Quote API" },
    { "id": "inventory", "type": "backend", "label": "Inventory Service" },
    { "id": "invoutbox", "type": "messagebus", "label": "Order Inventory Outbox" },
    { "id": "rabbit", "type": "messagebus", "label": "RabbitMQ" }
  ],
  "segments": [
    { "from": 196, "to": 428, "label": "Order creation and reservation" },
    { "from": 456, "to": 524, "label": "Invalid reservation: recovery" }
  ],
  "messages": [
    { "id": "create-order", "from": "web", "to": "order", "y": 160, "label": "Create order with quote_id", "variant": "emphasis" },
    { "id": "reload-quote", "from": "order", "to": "quote", "y": 216, "label": "Reload and validate the quote", "variant": "default" },
    { "id": "reserve-stock", "from": "order", "to": "inventory", "y": 244, "label": "POST /inventory/reservations/quote", "variant": "emphasis", "note": "Carries orderId; one hold per Order" },
    { "id": "reservation-active", "from": "inventory", "to": "order", "y": 272, "label": "reservationId and ACTIVE status", "variant": "return", "note": "Persist order as pending with reservationId" },
    { "id": "persist-inventory-event", "from": "order", "to": "invoutbox", "y": 328, "label": "Persist order.created inventory event", "variant": "default", "note": "Carries the Order's reservationId" },
    { "id": "publish-event", "from": "invoutbox", "to": "rabbit", "y": 356, "label": "Publish order.created", "variant": "dashed" },
    { "id": "deliver-event", "from": "rabbit", "to": "inventory", "y": 384, "label": "Deliver order.created", "variant": "dashed", "note": "Consume the reservation to SOLD" },
    { "id": "cash-response", "from": "order", "to": "web", "y": 412, "label": "Created order shops", "variant": "return" },
    { "id": "reservation-failed", "from": "inventory", "to": "order", "y": 468, "label": "RESERVATION_FAILED", "variant": "return" },
    { "id": "reservation-unavailable", "from": "order", "to": "web", "y": 496, "label": "CHECKOUT_QUOTE_RESERVATION_UNAVAILABLE", "variant": "return" }
  ],
  "activations": [
    { "participant": "web", "from": 152, "to": 502, "type": "frontend" },
    { "participant": "order", "from": 152, "to": 502, "type": "backend" },
    { "participant": "quote", "from": 210, "to": 278, "type": "backend" },
    { "participant": "inventory", "from": 238, "to": 392, "type": "backend" },
    { "participant": "invoutbox", "from": 322, "to": 362, "type": "messagebus" },
    { "participant": "rabbit", "from": 350, "to": 390, "type": "messagebus" }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Reserve before persisting",
      "items": [
        "Order creation calls POST /inventory/reservations/quote with orderId",
        "One remote hold is created per Order inside the order-creation transaction",
        "The order is persisted as pending only after the reservation is ACTIVE"
      ]
    },
    {
      "dot": "violet",
      "title": "order.created ownership",
      "items": [
        "Each order.created event carries that Order's reservationId",
        "The publisher publishes through RabbitMQ",
        "inventory-service consumes it and moves the matching reservation to SOLD"
      ]
    },
    {
      "dot": "rose",
      "title": "Reservation failure at order creation",
      "items": [
        "An out-of-stock or failed reservation returns RESERVATION_FAILED",
        "The storefront receives CHECKOUT_QUOTE_RESERVATION_UNAVAILABLE",
        "The buyer returns to the quote or catalog to restart checkout"
      ]
    }
  ]
}
