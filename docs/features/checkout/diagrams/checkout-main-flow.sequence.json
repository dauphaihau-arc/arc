{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Checkout Main Flow",
    "locale": "en",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [1640, 800],
    "views": [
      { "id": "quote-boundary", "label": "Quote boundary", "focus": ["buyer", "web", "quote"], "note": "Cart and buy-now both create a backend-owned quote before any order exists." },
      { "id": "order-reservation", "label": "Order reservation", "focus": ["web", "order", "quote", "inventory"], "note": "Order creation reserves stock inside the order-creation transaction." },
      { "id": "card-session", "label": "Card payment session", "focus": ["order", "outbox", "payment", "web"], "note": "One inline processing pass, then a pending checkout that the storefront polls." },
      { "id": "cash-close", "label": "Cash payment", "focus": ["order", "web", "buyer"], "note": "Cash confirms after local order creation returns created order shops." }
    ]
  },
  "participants": [
    { "id": "buyer", "type": "external", "label": "Buyer" },
    { "id": "web", "type": "frontend", "label": "Storefront Web" },
    { "id": "quote", "type": "backend", "label": "Checkout Quote API" },
    { "id": "order", "type": "backend", "label": "Order Creation API" },
    { "id": "inventory", "type": "backend", "label": "Inventory Service" },
    { "id": "outbox", "type": "messagebus", "label": "Checkout Outbox" },
    { "id": "payment", "type": "external", "label": "Payment Gateway" }
  ],
  "segments": [
    { "from": 196, "to": 272, "label": "Checkout quote" },
    { "from": 296, "to": 452, "label": "Order creation and reservation" },
    { "from": 460, "to": 620, "label": "Card payment: session" },
    { "from": 648, "to": 720, "label": "Cash payment" }
  ],
  "messages": [
    { "id": "buyer-input", "from": "buyer", "to": "web", "y": 160, "label": "Complete address, payment, review steps", "variant": "default" },
    { "id": "create-quote", "from": "web", "to": "quote", "y": 216, "label": "Create checkout quote", "variant": "emphasis" },
    { "id": "quote-result", "from": "quote", "to": "web", "y": 244, "label": "quote_id, totals, shops, expires_at", "variant": "return", "note": "No reservationId" },
    { "id": "create-order", "from": "web", "to": "order", "y": 300, "label": "Create order with quote_id and payment_type", "variant": "emphasis", "note": "Reloads and validates the quote" },
    { "id": "reload-quote", "from": "order", "to": "quote", "y": 328, "label": "Reload and validate the quote", "variant": "default" },
    { "id": "reserve-stock", "from": "order", "to": "inventory", "y": 356, "label": "POST /inventory/reservations/quote", "variant": "emphasis", "note": "Carries orderId; one hold per Order" },
    { "id": "reservation-active", "from": "inventory", "to": "order", "y": 384, "label": "reservationId and ACTIVE status", "variant": "return", "note": "Persist order as pending with reservationId" },
    { "id": "persist-session-event", "from": "order", "to": "outbox", "y": 468, "label": "Persist order.checkout-session-requested", "variant": "default" },
    { "id": "process-inline", "from": "order", "to": "outbox", "y": 496, "label": "Try processing the event once inline", "variant": "default", "note": "1500 ms timeout" },
    { "id": "create-session", "from": "outbox", "to": "payment", "y": 524, "label": "Create checkout session", "variant": "emphasis" },
    { "id": "session-url", "from": "payment", "to": "outbox", "y": 552, "label": "Checkout session URL", "variant": "return", "note": "Orders move to awaiting_payment" },
    { "id": "ready-response", "from": "order", "to": "web", "y": 580, "label": "checkout_session_url", "variant": "return", "note": "Otherwise checkout_pending and order ids" },
    { "id": "poll-readiness", "from": "web", "to": "order", "y": 608, "label": "Poll readiness by order ids", "variant": "emphasis", "note": "Every second, up to 30 seconds" },
    { "id": "cash-response", "from": "order", "to": "web", "y": 680, "label": "Created order shops", "variant": "return", "note": "Cash persists orders as pending" }
  ],
  "activations": [
    { "participant": "web", "from": 152, "to": 712, "type": "frontend" },
    { "participant": "quote", "from": 210, "to": 250, "type": "backend" },
    { "participant": "order", "from": 294, "to": 712, "type": "backend" },
    { "participant": "inventory", "from": 350, "to": 390, "type": "backend" },
    { "participant": "outbox", "from": 462, "to": 592, "type": "messagebus" },
    { "participant": "payment", "from": 518, "to": 558, "type": "external" }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Shared quote boundary",
      "items": [
        "Cart and buy-now create a quote before any order exists",
        "Quote owns totals, shipping, snapshots; no reservationId"
      ]
    },
    {
      "dot": "amber",
      "title": "Order-owned reservation",
      "items": [
        "Order creation calls POST /inventory/reservations/quote with orderId",
        "One hold per Order; reservationId stored on the order"
      ]
    },
    {
      "dot": "orange",
      "title": "Payment handling",
      "items": [
        "Card persists checkout_pending and polls session readiness",
        "Cash persists pending and returns created order shops"
      ]
    }
  ]
