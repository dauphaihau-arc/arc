{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Card Payment Session Flow",
    "locale": "en",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [1640, 900],
    "views": [
      { "id": "session-ready", "label": "Inline fast path", "focus": ["order", "coutbox", "payment", "web"], "note": "The inline post-commit pass returns a checkout session URL directly." },
      { "id": "session-pending", "label": "Worker claims the event", "focus": ["coutbox", "worker", "order", "web"], "note": "A pending session is created by the worker while the storefront polls readiness." },
      { "id": "payment-success", "label": "Payment success", "focus": ["payment", "order", "invoutbox", "inventory"], "note": "The Stripe webhook writes order.created carrying the Order's reservationId." },
      { "id": "session-expired", "label": "Session expiry", "focus": ["payment", "order", "worker", "inventory"], "note": "An expired provider session schedules cleanup to release the hold." }
    ]
  },
  "participants": [
    { "id": "web", "type": "frontend", "label": "Storefront Web" },
    { "id": "order", "type": "backend", "label": "Order Creation API" },
    { "id": "coutbox", "type": "messagebus", "label": "Checkout Outbox" },
    { "id": "worker", "type": "messagebus", "label": "Outbox Worker" },
    { "id": "payment", "type": "external", "label": "Payment Gateway" },
    { "id": "invoutbox", "type": "messagebus", "label": "Inventory Outbox" },
    { "id": "inventory", "type": "backend", "label": "Inventory Service" },
    { "id": "buyer", "type": "external", "label": "Buyer" }
  ],
  "segments": [
    { "from": 196, "to": 384, "label": "Card session: inline ready" },
    { "from": 412, "to": 636, "label": "Card session: pending, poll readiness" },
    { "from": 664, "to": 748, "label": "Card payment succeeds" },
    { "from": 752, "to": 824, "label": "Session expiry and cleanup" }
  ],
  "messages": [
    { "id": "persist-session-event", "from": "order", "to": "coutbox", "y": 216, "label": "Persist checkout-session-requested", "variant": "default", "note": "Order already holds reservationId" },
    { "id": "process-inline", "from": "order", "to": "coutbox", "y": 244, "label": "Try processing the event inline", "variant": "default", "note": "1500 ms timeout" },
    { "id": "create-session", "from": "coutbox", "to": "payment", "y": 272, "label": "Create checkout session", "variant": "emphasis" },
    { "id": "session-url", "from": "payment", "to": "coutbox", "y": 300, "label": "Checkout session URL", "variant": "return", "note": "Orders move to awaiting_payment" },
    { "id": "ready-response", "from": "order", "to": "web", "y": 328, "label": "checkout_session_url", "variant": "return" },
    { "id": "redirect-ready", "from": "web", "to": "buyer", "y": 356, "label": "Redirect to payment provider", "variant": "return" },
    { "id": "pending-response", "from": "order", "to": "web", "y": 440, "label": "checkout_pending and order ids", "variant": "return" },
    { "id": "poll-readiness", "from": "web", "to": "order", "y": 468, "label": "Poll readiness by order ids", "variant": "emphasis", "note": "Every second, up to 30 seconds" },
    { "id": "claim-event", "from": "worker", "to": "coutbox", "y": 496, "label": "Claim a pending event every 5s", "variant": "dashed" },
    { "id": "worker-session", "from": "worker", "to": "payment", "y": 524, "label": "Create checkout session", "variant": "emphasis" },
    { "id": "worker-update", "from": "worker", "to": "order", "y": 552, "label": "Update orders to awaiting_payment", "variant": "default" },
    { "id": "ready-after-poll", "from": "order", "to": "web", "y": 580, "label": "checkout_session_url", "variant": "return" },
    { "id": "redirect-pending", "from": "web", "to": "buyer", "y": 608, "label": "Redirect to payment provider", "variant": "return" },
    { "id": "payment-webhook", "from": "payment", "to": "order", "y": 692, "label": "POST /webhooks/stripe payment succeeded", "variant": "dashed", "note": "Orders move to paid" },
    { "id": "persist-inventory-event", "from": "order", "to": "invoutbox", "y": 720, "label": "Persist order.created inventory event", "variant": "default", "note": "Carries the Order's reservationId" },
    { "id": "consume-to-sold", "from": "invoutbox", "to": "inventory", "y": 736, "label": "Consume reservation to SOLD", "variant": "dashed" },
    { "id": "session-expired", "from": "payment", "to": "order", "y": 760, "label": "Provider session expired", "variant": "dashed" },
    { "id": "schedule-cleanup", "from": "order", "to": "worker", "y": 788, "label": "Schedule order.cleanup-expired-order-reservations", "variant": "dashed" },
    { "id": "cleanup-release", "from": "worker", "to": "inventory", "y": 816, "label": "Release reservation", "variant": "emphasis" }
  ],
  "activations": [
    { "participant": "order", "from": 152, "to": 800, "type": "backend" },
    { "participant": "coutbox", "from": 210, "to": 570, "type": "messagebus" },
    { "participant": "worker", "from": 490, "to": 824, "type": "messagebus" },
    { "participant": "payment", "from": 266, "to": 306, "type": "external" },
    { "participant": "web", "from": 322, "to": 614, "type": "frontend" },
    { "participant": "buyer", "from": 350, "to": 614, "type": "external" },
    { "participant": "invoutbox", "from": 714, "to": 750, "type": "messagebus" },
    { "participant": "inventory", "from": 742, "to": 824, "type": "backend" }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Checkout session",
      "items": [
        "Order holds reservationId; session created inline or by worker",
        "Readiness polling resolves pending sessions"
      ]
    },
    {
      "dot": "violet",
      "title": "Payment completion",
      "items": [
        "Stripe webhook moves orders to paid",
        "order.created carries reservationId; inventory moves it to SOLD"
      ]
    },
    {
      "dot": "rose",
      "title": "Session expiry",
      "items": [
        "Expired provider session releases the hold",
        "Fallback job order.cleanup-expired-order-reservations releases stale holds"
      ]
    }
  ]
}
