    { "id": "inventory", "type": "backend", "label": "Inventory Service" }
  ],
  "segments": [
    { "from": 196, "to": 220, "label": "Buyer input" },
    { "from": 236, "to": 292, "label": "Quote creation" },
    { "from": 308, "to": 356, "label": "Order creation request" },
