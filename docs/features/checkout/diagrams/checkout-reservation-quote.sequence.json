  "cards": [
    {
      "dot": "emerald",
      "title": "Reservation-backed quote",
      "items": [
        "With INVENTORY_RESERVATION_DRIVER=remote the inventory-service owns stock",
        "Quote creation calls POST /inventory/reservations/quote",
        "The returned reservationId is stored on the checkout quote"
      ]
    },
    {
      "dot": "rose",
      "title": "Reservation failure",
      "items": [
        "Every reserve failure returns the single code RESERVATION_FAILED",
        "The storefront receives stock or reservation recovery copy and no quote_id"
      ]
    }
