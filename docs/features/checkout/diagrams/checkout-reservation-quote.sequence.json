      { "id": "reservation-accepted", "label": "Reservation accepted", "focus": ["quote", "inventory", "web"], "note": "The reservationId is stored on the quote and returned to the storefront." },
      { "id": "reservation-failed", "label": "Reservation failed", "focus": ["inventory", "quote", "web"], "note": "A failed reservation returns one reserve failure code and no quote." }
    ]
  },
  "participants": [
    { "id": "buyer", "type": "external", "label": "Buyer" },
    { "id": "web", "type": "frontend", "label": "Storefront Web" },
    { "id": "quote", "type": "backend", "label": "Checkout Quote API" },
    { "id": "inventory", "type": "backend", "label": "Inventory Service" }
  ],
  "segments": [
    { "from": 196, "to": 244, "label": "Buyer input" },
    { "from": 272, "to": 384, "label": "Quote creation and stock hold" },
    { "from": 412, "to": 468, "label": "Reservation accepted" },
    { "from": 496, "to": 580, "label": "Reservation failed" }
  ],
  "messages": [
    { "id": "start-checkout", "from": "buyer", "to": "web", "y": 160, "label": "Start cart or buy-now checkout", "variant": "default" },
    { "id": "enter-details", "from": "buyer", "to": "web", "y": 188, "label": "Enter shipping and payment details", "variant": "default" },
    { "id": "confirm-order", "from": "buyer", "to": "web", "y": 216, "label": "Review and confirm", "variant": "default" },
    { "id": "create-quote", "from": "web", "to": "quote", "y": 300, "label": "Create checkout quote", "variant": "emphasis", "note": "Resolve currency, totals, per-shop shipping, and snapshots" },
    { "id": "request-reservation", "from": "quote", "to": "inventory", "y": 328, "label": "POST /inventory/reservations/quote", "variant": "emphasis" },
    { "id": "reservation-accepted", "from": "inventory", "to": "quote", "y": 356, "label": "reservationId and ACTIVE status", "variant": "return", "note": "Store reservationId on the checkout quote" },
    { "id": "quote-result", "from": "quote", "to": "web", "y": 440, "label": "quote_id, totals, shops, expires_at", "variant": "return" },
    { "id": "reservation-failed", "from": "inventory", "to": "quote", "y": 524, "label": "RESERVATION_FAILED", "variant": "return" },
    { "id": "stock-error", "from": "quote", "to": "web", "y": 552, "label": "Stock or reservation recovery error", "variant": "return" }
