#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

all_topics() {
  compgen -A function topic_ | sed 's/^topic_//'
}

print_usage() {
  cat <<'USAGE'
Usage: ./tools/agent/repo-map <topic>
       ./tools/agent/repo-map --list
       ./tools/agent/repo-map --check

Prints the docs, code surfaces, guidance files, and verification commands for
one Arc feature area. Run it before broad code search.

Topics:
USAGE
  all_topics | sed 's/^/  /'
  cat <<'USAGE'

--check exits non-zero when a topic names a missing path or an unknown
./scripts/verify target. It runs as part of ./scripts/verify architecture.
USAGE
}

section() {
  printf '\n%s\n' "$1"
  printf '%s\n' "----------------------------------------"
}

items() {
  for item in "$@"; do
    if [[ -e "$ROOT_DIR/$item" ]]; then
      printf '  %s\n' "$item"
    else
      printf '  %s (missing)\n' "$item"
    fi
  done
}

VERIFY_TARGETS=()

load_verify_targets() {
  [[ ${#VERIFY_TARGETS[@]} -gt 0 ]] && return 0
  local usage_line
  usage_line="$(sed -n 's#^Usage: \./scripts/verify \[all|\(.*\)\]$#\1#p' "$ROOT_DIR/scripts/verify")"
  read -r -a VERIFY_TARGETS <<<"${usage_line//|/ }"
}

verify_target_known() {
  local target="$1" known
  for known in "${VERIFY_TARGETS[@]}"; do
    [[ "$known" == "$target" ]] && return 0
  done
  return 1
}

commands() {
  local command target verdict
  load_verify_targets
  for command in "$@"; do
    verdict=""
    if [[ "$command" == "./scripts/verify "* ]]; then
      target="${command#./scripts/verify }"
      target="${target%% *}"
      verify_target_known "$target" || verdict=" (unknown verify target: $target)"
    fi
    printf '  %s%s\n' "$command" "$verdict"
  done
}

check_all() {
  local topic output status=0
  while IFS= read -r topic; do
    output="$("topic_$topic")"
    if grep -q -e '(missing)' -e '(unknown verify target' <<<"$output"; then
      printf '\n%s\n' "$topic"
      grep -e '(missing)' -e '(unknown verify target' <<<"$output" | sed 's/^/  /'
      status=1
    fi
  done < <(all_topics)
  if ((status == 0)); then
    echo "repo-map: every topic names existing paths and known verify targets."
  fi
  return "$status"
}

