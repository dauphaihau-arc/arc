#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
TOPIC="${1:-}"

print_usage() {
  cat <<'USAGE'
Usage: ./tools/agent/repo-map <topic>

Topics:
  checkout
  orders
  fulfillment
  shipping
  product-import
  multi-currency
  promotions
  catalog
  reviews
  realtime-chat
  notifications
  order-export
  inventory
  auth
  architecture

Use this before broad code search when starting work on a known Arc feature.
USAGE
}

section() {
  printf '\n%s\n' "$1"
  printf '%s\n' "----------------------------------------"
}

items() {
  for item in "$@"; do
    if [[ -e "$ROOT_DIR/$item" ]]; then
      printf '  %s\n' "$item"
    else
      printf '  %s (missing)\n' "$item"
    fi
  done
}

commands() {
  for command in "$@"; do
    printf '  %s\n' "$command"
  done
}

common_api_guidance() {
  section "API guidance"
  items \
    "apps/api/api/AGENTS.md" \
    "apps/api/api/agent-skills/README.md" \
    "apps/api/api/agent-skills/src-structure.md" \
    "apps/api/api/agent-skills/testing.md"
}

common_web_guidance() {
