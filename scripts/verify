#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TARGET="${1:-all}"

check_permissions() {
  node "$ROOT_DIR/scripts/generate-permissions.mjs" --check
}

run_api() {
  cd "$ROOT_DIR/apps/api/api"
  pnpm check
}

run_architecture() {
  check_permissions
  cd "$ROOT_DIR/apps/api/api"
  pnpm check:architecture
}

run_web() {
  cd "$ROOT_DIR/apps/web"
  pnpm check
}

run_seller() {
  cd "$ROOT_DIR/apps/web"
  pnpm check:seller
}

run_admin() {
  cd "$ROOT_DIR/apps/web"
  pnpm check:admin
}

run_storefront() {
  cd "$ROOT_DIR/apps/web"
  pnpm check:storefront
}

run_inventory() {
  cd "$ROOT_DIR/apps/api/inventory-service"
  go test ./...
}

run_mock_carrier() {
  cd "$ROOT_DIR"
  node --test apps/api/mock-carrier-service/test
}

case "$TARGET" in
  all)
    run_api
    check_permissions
    run_web
    run_inventory
    run_mock_carrier
    ;;
  api)
    run_api
    ;;
  architecture)
    run_architecture
    ;;
  permissions)
    check_permissions
    ;;
  web)
    run_web
    ;;
  seller)
    run_seller
    ;;
  admin)
    run_admin
    ;;
  storefront)
    run_storefront
    ;;
  inventory)
    run_inventory
    ;;
  mock-carrier)
    run_mock_carrier
    ;;
  *)
    cat >&2 <<USAGE
Usage: ./scripts/verify [all|api|architecture|permissions|web|seller|admin|storefront|inventory|mock-carrier]
USAGE
    exit 2
    ;;
esac
